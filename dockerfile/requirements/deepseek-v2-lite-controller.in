# Additional constraints for the dedicated Python 3.12 controller/reference runtime.
# Torch and torchvision are provided by the digest-pinned GPU base image.
# The NGC Torch build uses the NumPy 1.x ABI; keep its array bridge functional.
# Regenerate from the repository root with bash:
# uv pip compile setup.py dockerfile/requirements/deepseek-v2-lite-reference.txt \
#   dockerfile/requirements/deepseek-v2-lite-controller.in --python-version 3.12 \
#   --python-platform x86_64-unknown-linux-gnu --excludes <(printf 'torch\ntorchvision\n') \
#   --no-header --no-annotate -o dockerfile/requirements/deepseek-v2-lite-controller.txt
